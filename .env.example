# Copy to .env.local and fill in. Never commit .env.local.

# ── Client-exposed ───────────────────────────────────────────────────────────
# These are inlined into the JS bundle at BUILD time and are public forever.
# Do not put anything here you would mind a stranger reading.
NEXT_PUBLIC_SITE_URL=http://localhost:3111
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Server-only ──────────────────────────────────────────────────────────────
# NEVER prefix these with NEXT_PUBLIC_.
#
# The secret key bypasses Row Level Security completely. It is used in exactly
# one place — the /cv route, to sign URLs for the private documents bucket.
# src/lib/supabase/admin.ts imports 'server-only', so the build fails outright
# if it ever reaches a client component.
SUPABASE_SECRET_KEY=sb_secret_...

# Shared secret for the Supabase database webhook that revalidates the site
# when content is edited outside the admin UI. Generate with:
#   openssl rand -hex 32
REVALIDATE_SECRET=
